<apex:page standardController="Opportunity" extensions="OpportunityInvoiceController" renderAs="pdf" showHeader="false" applyHtmlTag="false">
    <html>
        <head>
            <style>
                body { 
                font-family: Arial, sans-serif; 
                font-size: 12px; 
                margin: 20px; 
                }
                
                /* Table Layout */
                .header-table {
                width: 100%;
                border-collapse: collapse;
                }
                
                .header-table td {
                vertical-align: top;
                padding: 5px;
                }
                
                /* Left Section - Company Details */
                .company-details {
                width: 50%;
                }
                
                /* Right Section - Statement Details */
                .statement-details {
                width: 50%;
                text-align: right;
                }
                
                /* Statement Info Table */
                .statement-table {
                width: 100%;
                margin-bottom: 10px;
                }
                
                .statement-table th, .statement-table td {
                padding: 6px;
                text-align: center;
                font-weight: bold;
                }
                
                .statement-table th {
                background-color: #0057c1;
                color: white;
                }
                
                .amount-due {
                background-color: #d9534f;
                color: white;
                }
                
                /* Insurance Table */
                .info-table { 
                width: 100%;
                }
                
                .info-table th, .info-table td { 
                padding: 6px;
                text-align: left;
                }
                
                .info-table th { 
                background-color: #0057c1;
                color: white;
                text-align: center;
                }
                
                .info-table td:first-child {
                font-weight: bold;
                }
                
                /* Claim Line Items Table */
                .claim-line-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 20px;
                }
                
                .claim-line-table th, .claim-line-table td {
                padding: 6px;
                text-align: center;
                border: 1px solid black;
                }
                
                .claim-line-table th {
                background-color: #0057c1;
                color: white;
                }
                .total-row td {
                border-top: 2px solid black !important; /* Top border */
                border-bottom: 2px solid black !important; /* Bottom border */
                font-weight: bold; /* Bold text */
                background-color: #f2f2f2; /* Light grey background */
                text-align: right; /* Align numbers to the right */
                }
                
                /* Keeps left and right borders but removes inner borders */
                .total-row td:not(:first-child):not(:last-child) {
                border-left: none !important; 
                border-right: none !important;
                }
                
                /* Detach Line */
                .detach-line {
                border-top: 2px dashed black;
                text-align: center;
                margin: 20px 0;
                padding-top: 10px;
                font-weight: bold;
                }
                
                /* Payment Stub Layout */
                .payment-stub {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
                }
                
                .payment-stub td {
                vertical-align: top;
                padding: 10px;
                }
                
                /* Left Side - Statement Details */
                .statement-info {
                width: 50%;
                border: 1px solid black;
                }
                
                /* Right Side - Card Payment */
                .card-payment {
                width: 50%;
                border: 1px solid black;
                }
                
                .payment-table {
                width: 100%;
                border-collapse: collapse;
                }
                
                .payment-table th, .payment-table td {
                padding: 6px;
                border: 1px solid black;
                text-align: left;
                }
                
                .payment-table th {
                background-color: #0057c1;
                color: white;
                text-align: center;
                }
                
                /* Make Check Payable Section */
                .make-checks {
                margin-top: 15px;
                font-weight: bold;
                text-align: center;
                }
                
                .pay-now {
                text-decoration: none;
                font-weight: bold;
                color: #0057c1;
                font-size: 14px;
                }
                
                html, body {
                height: auto;
                margin: 0;
                padding: 0;
                }
                
                table, tr, td, div {
                page-break-inside: avoid;
                }
                
            </style>
        </head>
        <body>
            <table class="header-table">
                <tr>
                    <!-- Left - Company Details -->
                    <td class="company-details">
                        <!-- <apex:image url="{!$Resource.ArteraLogo}" width="200" height="60"/>  -->           
                        <div>
                            <b>Artera Inc.</b><br/>
                            6800 Southpoint Pkwy Ste. 950<br/>
                            Jacksonville, FL 32216-8203<br/>
                            <!-- <b>Phone:</b> (650) 239-7018 <br/>
<b>Email:</b> billing@artera.ai-->
                        </div>
                        <br/>
                        <br/>
                        <apex:outputText value="{!Opportunity.Account.Name}"/><br/>
                        <apex:outputText value="{!Opportunity.Account.BillingStreet}"/><br/>
                        <apex:outputText value="{!Opportunity.Account.BillingCity}, {!Opportunity.Account.BillingState}, {!Opportunity.Account.BillingPostalCode}"/><br/>
                        <apex:outputText value="{!Opportunity.Account.BillingCountry}"/>
                        
                        <!-- <div style="font-weight: bold; font-size:12px; color:#0057c1; margin-top:5px;">Scan to Pay</div>
<div style="margin-top:10px; text-align:left;">
<apex:image url="{!
'https://api.qrserver.com/v1/create-qr-code/?size=80x80&data=' &
IF(
BEGINS(Opportunity.Payment_Link__c, 'http'),
Opportunity.Payment_Link__c,
'https://' & Opportunity.Payment_Link__c
)
}" width="80" height="80" alt="Payment QR Code"/>
</div>
<div class="well" style="word-break: break-all; text-align:left; margin-top: 10px;">
<a href="{!IF(Opportunity.Payment_Link__c != null, 
IF(BEGINS(Opportunity.Payment_Link__c, 'http'), 
Opportunity.Payment_Link__c, 
'https://' + Opportunity.Payment_Link__c), 
'')}" 
target="_blank" 
class="pay-now" 
style="text-decoration: none; font-weight: bold; color: #0057c1; font-size: 14px;">
pay now
</a>
</div>
{!IF(
Opportunity.Payment_Link__c != null, 
IF(
BEGINS(Opportunity.Payment_Link__c, 'http'), 
Opportunity.Payment_Link__c, 
'https://' + Opportunity.Payment_Link__c
), 
''
)}-->
                    </td>
                    
                    <!-- Right - Statement Details -->
                    <td class="statement-details">
                        <table class="statement-table">
                            <tr>
                                <th>Statement Date:</th>
                                <th class="amount-due">Amount Due:</th>
                                <th>Statement #:</th>
                            </tr>
                            <tr>
                                <td><apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!TODAY()}"/></apex:outputText></td>
                                <td class="amount-due"><apex:outputText value="{!totalAmountDue}"/></td>
                                <td>{!Opportunity.Statement_Number__c}</td>
                            </tr>
                        </table>
                        <!-- Insurance Details -->
                        <table class="info-table">
                            <tr>
                                <th colspan="3">Most Recent Insurance Claim Filed To:</th>
                            </tr>
                            <tr>
                                <td style="width:40%">Patient: </td>
                                <td style="text-align: left;width:40% ">{!Opportunity.Account.Name}</td>
                                <td style="width:40%"></td>
                            </tr>
                            <tr>
                                <td style="width:40%">Insurance:</td>
                                <td style="text-align: left;width:40% ">{!Opportunity.Payer__r.Name}</td>
                                <td style="width:40%"></td>
                            </tr>
                            <tr>
                                <td style="width:40%">Subscriber:</td>
                                <td style="text-align: left;width:40% ">{!memberPlanSubscriber}</td>
                                <td style="width:40%"></td>
                            </tr>
                            <tr>
                                <td style="width:40%">Ordering Provider:</td>
                                <td style="text-align: left;width:40% ">{!Opportunity.Sales_Order__r.Contact__r.Name}</td>
                                <td style="width:40%"></td>
                            </tr>
                            <tr>
                                <td style="width:40%">Encounter:</td>
                                <td style="text-align: left;width:40% ">{!Opportunity.Name}</td>
                                <td style="width:40%"></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            
            <!-- Claim Line Items Table -->
            <table class="claim-line-table">
                <tr>
                    <th>Date of Service</th>
                    <th>CPT</th>
                    <th>Description</th>
                    <th>Charge</th>
                    <th>Adjustment</th>
                    <th>Insurance Paid</th>
                    <th>Patient Paid</th>
                    <th>Balance</th>
                </tr>
                <apex:repeat value="{!optyLines}" var="oli">
                    <tr>
                        <td>{!formattedDates[oli.Id]}</td>
                        <td>{!oli.Product2.Name}</td>
                        <td>ArteraAI Prostate Test</td>
                        <td>{!oli.TotalPrice}</td>
                        <td>{!oli.Adj_Amount__c}</td>
                        <td>{!oli.Payment_By_Insurance__c}</td>
                        <td>{!oli.Payment_By_Patient__c}</td>
                        <td>{!oli.Balance__c}</td>
                    </tr>
                </apex:repeat>
                <tr class="total-row">
                    <td style="text-align: left;"><b>Total</b></td>
                    <td style="border: none;"></td>
                    <td style="border: none;"></td>
                    <td style="text-align: center;"><apex:outputText value="${!totalCharge}"/></td>
                    <td style="text-align: center;"><apex:outputText value="${!totalAdjustment}"/></td>
                    <td style="text-align: center;"><apex:outputText value="${!totalInsurancePaid}"/></td>
                    <td style="text-align: center;"><apex:outputText value="${!totalPatientPaid}"/></td>
                    <td style="text-align: center;"><apex:outputText value="${!totalBalance}"/></td>
                </tr>
            </table>
            <br/>
            <!-- Balance Due Message -->
            <div class="balance-due">
                BALANCE DUE UPON RECEIPT - If you have concerns about paying your balance, then please contact us to discuss payment options or financial assistance.Call us at 650-239-7018 or email us at billing@artera.ai
            </div>
            <apex:outputPanel layout="block"
                              rendered="{!AND(NOT(ISNULL(Opportunity.Payment_Link__c)), LEN(TRIM(Opportunity.Payment_Link__c)) > 0)}">
                <table style="width:100%; margin-top:15px;">
                    <tr>
                        
                        <!-- LEFT COLUMN: Scan to Pay -->
                        <td style="width:33%; text-align:left;">
                            <div style="font-weight: bold; font-size:12px; color:#0057c1;">
                                Scan to Pay
                            </div>
                            
                            <div style="margin-top:5px;">
                                <apex:image url="{!
                                                 'https://api.qrserver.com/v1/create-qr-code/?size=80x80&data=' &
                                                 IF(
                                                 BEGINS(Opportunity.Payment_Link__c, 'http'),
                                                 Opportunity.Payment_Link__c,
                                                 'https://' & Opportunity.Payment_Link__c
                                                 )
                                                 }"
                                            width="80" height="80"
                                            style="width:80px; height:80px;"
                                            alt="Payment QR Code"
                                            />
                            </div>
                        </td>
                        
                        <!-- Financial Assistance -->
                        <td style="width:33%; vertical-align:top;">
            <apex:outputPanel rendered="{!Opportunity.Payer__r.Name != 'Self Pay'}">
                <div style="padding-top:5px; text-align:left;">
                    <div style="font-weight:bold;
                                font-size:12px;
                                line-height:14px;
                                color:#0057c1;">
                        Financial Assistance
                    </div>

                    <div style="margin-top:6px;">
                        <apex:image url="{!URLFOR($Resource.FinancialAssistanceQR)}"
                            style="width:95px; height:95px;"
                            alt="Financial Assistance QR"/>
                    </div>
                </div>
            </apex:outputPanel>
        </td>
                        
                        
                        <!-- RIGHT COLUMN: pay now -->
                        <td style="width:33%; text-align:right; vertical-align:middle;">
                            <a href="{!IF(Opportunity.Payment_Link__c != null, 
                                     IF(BEGINS(Opportunity.Payment_Link__c, 'http'), 
                                     Opportunity.Payment_Link__c, 
                                     'https://' + Opportunity.Payment_Link__c), 
                                     '')}" 
                               target="_blank" 
                               class="pay-now"
                               style="text-decoration: none; font-weight: bold; color: #0057c1; font-size: 14px;">
                                pay now
                            </a>
                            
                            <div>
                                {!IF(
                                Opportunity.Payment_Link__c != null, 
                                IF(
                                BEGINS(Opportunity.Payment_Link__c, 'http'), 
                                Opportunity.Payment_Link__c, 
                                'https://' + Opportunity.Payment_Link__c
                                ), 
                                ''
                                )}
                            </div>
                        </td>
                        
                    </tr>
                </table>
                
                
                
                
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!NOT(ISBLANK(optyLines))}">
                <br/>
                <div class="detach-line"> ─────────────────── Please Detach Here ─────────────────── </div>
                
                <table style="width:100%; margin-top:15px;">
                    <tr>
                        <!-- Left Side - Statement Info -->
                        <td class="statement-details" style="width:50%; vertical-align:top;">
                            <table class="statement-table">
                                <tr>
                                    <th>Statement Date:</th>
                                    <th class="amount-due">Amount Due:</th>
                                    <th>Statement #:</th>
                                </tr>
                                <tr>
                                    <td><apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!TODAY()}"/></apex:outputText></td>
                                    <td class="amount-due"><apex:outputText value="{!totalAmountDue}"/></td>
                                    <td>{!Opportunity.Statement_Number__c}</td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="text-align: left; padding-left: 40px;">
                                        <strong>Artera Inc.</strong><br/>
                                        P.O. Box 1073<br/>
                                        Brattleboro, VT 05302-1073<br/><br/><br/><br/><br/><br/>
                                        <apex:outputText value="{!Opportunity.Account.Name}"/><br/>
                                        <apex:outputText value="{!Opportunity.Account.BillingStreet}"/><br/>
                                        <apex:outputText value="{!Opportunity.Account.BillingCity}, {!Opportunity.Account.BillingState}, {!Opportunity.Account.BillingPostalCode}"/><br/>
                                        <apex:outputText value="{!Opportunity.Account.BillingCountry}"/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        
                        <!-- Right Side - Credit Card Payment -->
                        <td style="width:50%; vertical-align:top;">
                            <table class="payment-table" style="border-radius:10px;margin-bottom:27%; border-collapse:separate; border-left: 2px solid black; border-right: 2px solid black; border-bottom: 2px solid black; width: 100%; border:solid black 1px; border-collapse: collapse;">
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 5px;">
                                        <apex:image url="{!$Resource.VisaLogo}" width="50" height="20" style="margin-right: 20px;"/>
                                        <apex:image url="{!$Resource.MasterCardLogo}" width="50" height="20" style="margin-right: 20px;"/>
                                        <apex:image url="{!$Resource.DiscoverLogo}" width="50" height="20" style="margin-right: 20px;"/>
                                        <apex:image url="{!$Resource.AmexLogo}" width="50" height="20" style="margin-right:0;"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="4" style="border-top: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; padding: 5px;">Card Holder Name:</td>
                                </tr>
                                <tr>
                                    <td colspan="4" style="border-left: 1px solid black; border-right: 1px solid black; padding: 5px;">Card Number:</td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 5px; width: 30%;">Expiration Date: <span>MM / YY</span></td>
                                    <td style="border: 1px solid black; padding: 5px; width: 15%;">CCV:</td>
                                    <td style="border: 1px solid black; padding: 5px; width: 25%;">Statement #:</td>
                                    <td style="border: 1px solid black; padding: 5px; width: 30%;"><b style="color: blue;"></b></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border-left: 1px solid black; padding: 5px;">Signature:</td>
                                    <td colspan="2" style="border-right: 1px solid black; padding: 5px;">Payment Amount: $</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                
                <table style="width:100%; margin-top:10px;">
                    <tr>
                        <td style="width:50%;"></td>
                        <td style="width:50%; vertical-align: top; padding-top: 0px; line-height: 1; margin-top:-20px;">
                            <div style="margin-top:-20px;">
                                MAKE CHECK(S) PAYABLE/REMIT TO<br />
                                Artera Inc.,<br />
                                P.O. Box 1073,<br />
                                Brattleboro, VT 05302-1073
                            </div>
                        </td>
                    </tr>
                </table>
            </apex:outputPanel>
        </body>
    </html>
</apex:page>