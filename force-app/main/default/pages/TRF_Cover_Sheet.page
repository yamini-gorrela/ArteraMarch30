        <p style="margin: 0;"><strong>PHONE:</strong> 650-239-7018</p>
        <p style="margin: 0;"><strong>DATE:</strong> {!TEXT(MONTH(TODAY())) + '/' + TEXT(DAY(TODAY())) + '/' + TEXT(YEAR(TODAY()))}</p>

